# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used only by Drizzle Kit when creating or applying migrations
DATABASE_URL=postgresql://postgres.project:password@host:6543/postgres?sslmode=require

# Server-only Gemini API configuration
GEMINI_API_KEY=your-server-only-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_APP_RPM_LIMIT=5
GEMINI_APP_DAILY_LIMIT=100
